# Python
__pycache__/
*.py[cod]
.venv/
*.egg-info/
build/
dist/

# Tool caches and coverage output
.ruff_cache/
.mypy_cache/
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Secrets and local config. .env.example stays tracked.
.env
.env.*
!.env.example

# Real Rules of Engagement files name clients and people. The committed example
# in examples/ is the only one that belongs in git.
engagements/

# Raw run output can contain target responses, so it never goes into git.
# Sanitized evidence meant for the README goes in proof/ instead.
reports/
evidence/
runs/

# Editors and OS
.idea/
.vscode/
.DS_Store

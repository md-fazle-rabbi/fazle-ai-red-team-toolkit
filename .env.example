# fazle-ai-red-team-toolkit: environment template
# Copy to .env and fill in real values. Never commit .env itself.
# Populated incrementally as packages are built.

ENVIRONMENT=development
LOG_LEVEL=INFO

# Path to the Rules of Engagement file for this run. Every run needs one. No file, no run.
REDTEAM_ROE_PATH=

# Target credentials never go in the Rules of Engagement file. The file names the
# environment variable to read, and the value lives here or in your shell. Example:
# TARGET_TOKEN_LOCAL=
